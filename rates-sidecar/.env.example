# Firefly III rates sidecar — environment variables
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.

# Required: URL of your Firefly III instance (internal docker network name or external URL)
FIREFLY_URL=http://firefly_iii_core:8080

# Required: Personal Access Token from Firefly III
# Generate at: Firefly III > Options > Profile > OAuth > Personal Access Tokens > Create new token
# The token needs full API scope (Firefly III does not support granular PAT scopes).
FIREFLY_PAT=eyJ0eXAiOiJKV1Q...

# Optional: Timezone for the cron schedule (default: Europe/Madrid)
# Changing this requires restarting the container (node-cron resolves TZ at process startup).
RATES_SIDECAR_TZ=Europe/Madrid

# Optional: Log level — "info" (default) or "debug"
LOG_LEVEL=info

# Optional: How often (ms) the sidecar polls Firefly preferences for config changes.
# Default: 300000 (5 minutes). Changes to schedule/enabled take effect within this interval.
CONFIG_POLL_INTERVAL_MS=300000
